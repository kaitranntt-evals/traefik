+// verifyDropService (audit instrumentation) lists the generated services and, when
+// VERIFY_DROP=<scope>:<substring> matches, removes the matching services only.
+func verifyDropService(t *testing.T, conf *dynamic.Configuration, scope string) {
+	t.Helper()
+	var names []string
+	for name := range conf.HTTP.Services {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	scopeWant, sub, _ := strings.Cut(os.Getenv("VERIFY_DROP"), ":")
+	for _, name := range names {
+		if strings.Contains(name, "listener-fallback") {
+			t.Logf("VERIFY generated fallback service %s (router rule: %s)", name, conf.HTTP.Routers[name].Rule)
+		}
+		if sub != "" && scopeWant == scope && strings.Contains(name, sub) {
+			delete(conf.HTTP.Services, name)
+			t.Logf("VERIFY removed service %s", name)
+		}
+	}
+}
